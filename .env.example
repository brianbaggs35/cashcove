# Copy to .env and adjust. Never commit .env.

# The hostname you'll browse to, e.g. a domain pointed at this machine's private IP. Use
# exactly the name in the address bar: passkeys only work at this name, and not at an IP.
CASHCOVE_SERVER_NAME=cashcove.example.com
# Host ports. Keep 443 unless something else already uses it.
CASHCOVE_HTTPS_PORT=443
CASHCOVE_HTTP_PORT=80
TZ=America/Chicago

# Plaid keys from https://dashboard.plaid.com/developers/keys (see Plaid in README.md). The
# sandbox and production have different secrets.
CASHCOVE_PLAID_ENV=sandbox
CASHCOVE_PLAID_CLIENT_ID=
CASHCOVE_PLAID_SECRET=
# Where your banks are, as Plaid's country codes, e.g. US,CA.
# CASHCOVE_PLAID_COUNTRY_CODES=US
# Banks that sign in on their own website come back to https://<name>/connect/oauth instead
# of a pop-up. Add that address to Allowed redirect URIs in Plaid's dashboard first.
# CASHCOVE_PLAID_OAUTH_REDIRECT=false

# Where exchange rates come from, so accounts in other currencies count toward the budget in the
# household's own (see README.md). Only currency codes and dates are sent. Point it at your own
# Frankfurter server (https://frankfurter.dev), or set it to nothing to turn lookups off.
# CASHCOVE_EXCHANGE_RATE_URL=https://api.frankfurter.dev

# API worker processes.
CASHCOVE_API_WORKERS=2

# To run a published release (`make pull`) rather than building the image here (`make up`):
# CASHCOVE_IMAGE=ghcr.io/brianbaggs35/cashcove
# CASHCOVE_VERSION=1.4.0

# The app secret key, which encrypts authenticator-app keys. Leave it unset and the
# container creates one in its data volume; set it (from `make secret-key`) when moving
# to a new server. It must be at least 32 characters.
# CASHCOVE_SECRET_KEY=

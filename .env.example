# Copy to .env and adjust. Never commit .env.

# The hostname you'll browse to, e.g. a domain pointed at this machine's private IP.
CASHCOVE_SERVER_NAME=cashcove.example.com
# Host ports. Keep 443 unless something else already uses it.
CASHCOVE_HTTPS_PORT=443
CASHCOVE_HTTP_PORT=80
TZ=America/Chicago

# Plaid keys from https://dashboard.plaid.com/developers/keys
CASHCOVE_PLAID_ENV=sandbox
CASHCOVE_PLAID_CLIENT_ID=
CASHCOVE_PLAID_SECRET=

# API worker processes.
CASHCOVE_API_WORKERS=2
